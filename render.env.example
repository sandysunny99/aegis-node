# Render environment template (copy values into the Render dashboard; never commit real keys).
# Secrets below are intentionally blank. APP_ENV=production refuses to start with
# Cloudflare's test Turnstile keys, ALLOWED_ORIGINS=["*"], or no API_KEY and no Turnstile.
APP_ENV=production
AI_PROVIDER=groq
AI_FALLBACK_CHAIN=nvidia,cloudflare,huggingface,freellmapi
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
NVIDIA_API_KEY=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
FREELLMAPI_ENABLED=false
ALLOWED_ORIGINS=["https://aegis-node.onrender.com"]
API_KEY=
