# R10: store text as LF in the repo and check it out as LF on every OS,
# so Windows clones stop warning "LF will be replaced by CRLF".
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary datasets and assets: never touch line endings
*.parquet binary
*.xlsx binary
*.png binary
*.jpg binary
*.ico binary
*.db binary
