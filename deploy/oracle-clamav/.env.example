# Copy to .env on the VM (never commit .env). Generate the token with:
#   openssl rand -base64 48
SCAN_GATEWAY_TOKEN=
# Public DNS name pointing at the VM's public IP, e.g. a free DuckDNS name.
SCAN_DOMAIN=
# Leave empty on the VM. "tls internal" only for a local test without a public domain.
CADDY_TLS_DIRECTIVE=
MAX_UPLOAD_MB=50
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_SCANS=2
