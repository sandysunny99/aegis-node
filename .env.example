# Aegis Node — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it contains secrets!
#
# Quick start:
#   cp .env.example .env
#   nano .env   (add your API key)
#   docker compose up -d --build

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-before-production-use-a-random-32-char-string

# ─── API Key Guard (optional write-endpoint protection) ───────────────────────
# Leave empty for local dev (open access). Set a long random string in production
# to protect /upload, /scan, /remediate. Clients must send: X-API-Key: <value>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ─── Download Token Expiry ────────────────────────────────────────────────────
# Minutes before a download token expires after remediation. 0 = never expires.
DOWNLOAD_TOKEN_EXPIRY_MINUTES=60

# ─── AI Provider Selection ────────────────────────────────────────────────────
# Choose: gemini | groq | ollama | none
# If "none" or API key is missing, the app still works — AI panel is hidden.
AI_PROVIDER=gemini

# ─── Google Gemini (Recommended — free tier available) ────────────────────────
# Get a free API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# ─── Groq Cloud (Alternative — ultra-fast Llama 3.1, free tier) ──────────────
# Get a free API key from https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=20

# ─── Ollama (Local — 100% free, fully offline, no API key needed) ─────────────
# Install from https://ollama.com — then: ollama pull llama3.1
# Set AI_PROVIDER=ollama to use this.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60

# ─── ClamAV Scanner ───────────────────────────────────────────────────────────
# Docker Compose: use service name "clamav" as host
# Local dev:      use "localhost"
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MAX_UPLOAD_SIZE_MB=500

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — no setup required)
DATABASE_URL=sqlite:///./aegis_node.db
