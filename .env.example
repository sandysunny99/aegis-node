# Aegis Node — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it contains secrets!
#
# Quick start:
#   cp .env.example .env
#   nano .env   (add your API key)
#   docker compose up -d --build

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=["*"]
TRUSTED_PROXIES=["127.0.0.1","::1"]

# ─── API Key Guard (optional write-endpoint protection) ───────────────────────
# Leave empty for local dev (open access). Set a long random string in production
# to protect /upload, /scan, /remediate. Clients must send: X-API-Key: <value>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ─── Download Token Expiry ────────────────────────────────────────────────────
# Minutes before a download token expires after remediation. 0 = never expires.
DOWNLOAD_TOKEN_EXPIRY_MINUTES=60

# ─── AI Provider Selection ────────────────────────────────────────────────────
# Primary AI provider: groq | nvidia | huggingface | cloudflare | xai | ollama | none
# If "none" or API key is missing, the app still works — AI panel shows setup instructions.
AI_PROVIDER=groq

# ─── AI Fallback Chain ──────────────────────────────────────────────────────
# Comma-separated list of providers to try if the primary fails (rate limit,
# outage, bad output). Leave empty to disable fallback (default behaviour).
# Example: AI_FALLBACK_CHAIN=nvidia,huggingface,cloudflare,xai,ollama,freellmapi
AI_FALLBACK_CHAIN=nvidia,huggingface,cloudflare,xai,ollama,freellmapi

# ─── Groq Cloud (Primary — Free/Development limits apply) ──────────────
# Get a free API key from https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20

# ─── NVIDIA NIM (Direct Fallback — Free/Development limits apply) ──────────────
# Get a free API key from https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_TIMEOUT_SECONDS=30

# ─── Hugging Face (Direct Fallback — Free/Development limits apply) ──────────────
# Get a free API token from https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
HF_TIMEOUT_SECONDS=30

# ─── Cloudflare Workers AI (Direct Fallback — Free/Development limits apply) ──────────────
# Get an API token and Account ID from https://dash.cloudflare.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CLOUDFLARE_TIMEOUT_SECONDS=30

# ─── xAI / Grok (Optional Fallback) ────────────────────────
# Get an API key from https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_TIMEOUT_SECONDS=30

# ─── Ollama (Local — 100% free, fully offline, no API key needed) ─────────────
# Install from https://ollama.com — then: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60

# ─── FreeLLMAPI (Optional Terminal Gateway Fallback) ─────────────────────────────
# Set to true to enable FreeLLMAPI as the last-resort fallback.
FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_TIMEOUT_SECONDS=30

# Optional separate API keys for fallback providers.
# If empty, the same primary key is reused for that provider.
FALLBACK_GROQ_API_KEY=
FALLBACK_NVIDIA_API_KEY=
FALLBACK_HF_TOKEN=
FALLBACK_CLOUDFLARE_API_TOKEN=
FALLBACK_XAI_API_KEY=

# ─── Google Gemini (Deprecated Primary, Free tier available) ────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# ─── Scanner & Heuristics ────────────────────────────────────────────────────
# For Docker Compose (recommended) use:
CLAMAV_HOST=clamav
# For native local development (uvicorn without Docker) use:
# CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_MOCK_MODE=false
ENABLE_HEURISTICS=true
MAX_UPLOAD_SIZE_MB=500

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — no setup required)
DATABASE_URL=sqlite:///./aegis_node.db
